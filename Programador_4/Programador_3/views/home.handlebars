<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Confira os nossos produtos:</h1>
    <div class="main-container-produtos">
    {{#each products}}
    <div>
        <h2>{{this.title}}</h2>
        <p>R$ {{this.price}}</p>
        <p><a href="/product/{{this.id}}">Ver mais</a></p>
    </div>
    {{/each}}
    </div>
</body>
</html>